<Window x:Class="AutoMouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoMouse.ViewModels"
        mc:Ignorable="d"
        Title="AutoMouse - 鼠标键盘自动操作工具"
        Height="600" Width="800"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="状态:" Style="{StaticResource StatusLabel}" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLabel}" Foreground="#0066CC" MinWidth="200"/>
                <TextBlock Text="事件数:" Style="{StaticResource StatusLabel}" FontWeight="Bold" Margin="20,0,0,0"/>
                <TextBlock Text="{Binding EventCount}" Style="{StaticResource StatusLabel}" MinWidth="50"/>
                <TextBlock Text="时长:" Style="{StaticResource StatusLabel}" FontWeight="Bold" Margin="20,0,0,0"/>
                <TextBlock Text="{Binding RecordTime}" Style="{StaticResource StatusLabel}" MinWidth="80"/>
            </StackPanel>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Margin="5" Padding="5">

            <!-- 录制 Tab -->
            <TabItem Header="录制" Padding="15,5">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                        <Button Content="开始录制" Command="{Binding Record.StartRecordCommand}"
                                Style="{StaticResource ActionButton}" Background="#E8F5E9"
                                IsEnabled="{Binding Record.IsRecording, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="停止录制" Command="{Binding Record.StopRecordCommand}"
                                Style="{StaticResource ActionButton}" Background="#FFEBEE"
                                IsEnabled="{Binding Record.IsRecording}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding Record.LastSavedMessage}"
                               FontSize="13" Margin="0,10" HorizontalAlignment="Center"
                               Foreground="#666666"/>

                    <Border Grid.Row="2" Background="#F5F5F5" Padding="15" Margin="0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="热键说明" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="F9 - 开始录制  |  F10 - 停止录制  |  F7 - 开始回放  |  F8 - 停止回放" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" Text="点击「开始录制」后，所有鼠标和键盘操作将被记录。
停止录制后自动保存为脚本，可在「回放」和「脚本管理」中查看。"
                               FontSize="12" Foreground="#888888" Margin="0,20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- 回放 Tab -->
            <TabItem Header="回放" Padding="15,5">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="选择脚本:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Playback.Scripts}"
                                  SelectedItem="{Binding Playback.SelectedScript}"
                                  DisplayMemberPath="Name"
                                  Width="250" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="循环次数:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Width="60" Padding="5"
                                 Text="{Binding Playback.LoopCount}"
                                 IsEnabled="{Binding Playback.InfiniteLoop, Converter={StaticResource InverseBoolConverter}}"/>
                        <CheckBox Content="无限循环" Margin="20,0,0,0"
                                  IsChecked="{Binding Playback.InfiniteLoop}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                        <Button Content="开始回放" Command="{Binding Playback.PlayCommand}"
                                Style="{StaticResource ActionButton}" Background="#E3F2FD"
                                IsEnabled="{Binding Playback.IsPlaying, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="停止回放" Command="{Binding Playback.StopCommand}"
                                Style="{StaticResource ActionButton}" Background="#FFF3E0"
                                IsEnabled="{Binding Playback.IsPlaying}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="{Binding Playback.PlaybackStatus}"
                               FontSize="13" Margin="0,10" Foreground="#666666"
                               HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>

            <!-- 脚本管理 Tab -->
            <TabItem Header="脚本管理" Padding="15,5">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="已保存的脚本" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ScriptList.Scripts}"
                              SelectedItem="{Binding ScriptList.SelectedScript}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="加载" Command="{Binding ScriptList.LoadCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="重命名" Command="{Binding ScriptList.RenameCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="删除" Command="{Binding ScriptList.DeleteCommand}" Style="{StaticResource ActionButton}" Background="#FFEBEE"/>
                        <Button Content="刷新" Command="{Binding ScriptList.RefreshCommand}" Style="{StaticResource ActionButton}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="{Binding ScriptList.StatusMessage}"
                               FontSize="12" Foreground="#666666" Margin="0,5"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部信息栏 -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10,5">
            <TextBlock Text="AutoMouse v1.0 | 脚本存储: %APPDATA%/AutoMouse/scripts/"
                       FontSize="11" Foreground="#888888"/>
        </Border>
    </Grid>
</Window>
